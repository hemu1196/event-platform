# Running Port (Render binds to PORT dynamically)
PORT=5001
NODE_ENV=production

# JWT Configuration
JWT_SECRET=supersecretcollegecapstone123

# Supabase API endpoints (Retrieve from Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Keys (Leave empty to enable simulated Demo Mode!)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
